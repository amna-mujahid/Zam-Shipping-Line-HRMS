# MySQL connection (database created by `npm run db:setup`)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zam_hrms
DB_SSL=false

# Secret used to sign login sessions. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Port for the backend API (the frontend dev server on 3000 proxies /api here)
PORT=4000

# Frontend URL(s) allowed to call the API from another domain, comma-separated
# (e.g. https://zam-hrms.vercel.app). Not needed when the frontend proxies /api.
CORS_ORIGIN=zam-shipping-line-hrms-5ttd8frm3-amna-mujahid.vercel.app

# Auto-absent: days back to mark missing working days as Absent (0 = off)
AUTO_ABSENT_DAYS=31
